# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Port (Render will provide this automatically)
PORT=3000

# Node Environment
NODE_ENV=development

# Database (PostgreSQL for production, SQLite for local dev)
# For local dev, leave commented to use SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/voyage_planner
# For Render, this will be automatically provided when you add PostgreSQL

# JWT Secret (generate a secure random string)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-change-this-too

# JWT Expiration
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081
FRONTEND_URL_PROD=https://your-app-url.com
