{
  "name": "voyage-planner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios:dev": "npx eas build --profile development --platform ios",
    "build:ios:prod": "npx eas build --profile production --platform ios",
    "build:android:dev": "npx eas build --profile development --platform android",
    "build:android:prod": "npx eas build --profile production --platform android",
    "submit:ios": "npx eas submit --platform ios",
    "submit:android": "npx eas submit --platform android",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "generate:jwt": "node -e \"console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex')); console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.32",
    "expo-linking": "^8.0.11",
    "expo-router": "~6.0.22",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
