{
  "expo": {
    "name": "Voyage Planner",
    "slug": "voyage-planner",
    "scheme": "voyageplanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette app n'utilise pas la caméra",
        "NSPhotoLibraryUsageDescription": "Cette app n'utilise pas vos photos",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.dreille.voyageplanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "INTERNET"
      ],
      "package": "com.dreille.voyageplanner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d13d7e7-adfb-4037-95e4-f8f10e6adfb6"
      }
    }
  }
}
